<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SFW.Controls.GroupCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- One selector group (SFM group card): tag + type + count capsule, the group
         URL-test and expand actions, then either the chip grid or the collapsed dot
         grid. Both grids are supplied by the page so the layout panels stay there. -->
    <Border Style="{StaticResource CardBorderStyle}" Padding="0">
        <StackPanel>
            <Grid x:Name="Header" Padding="16,12,8,10" ColumnSpacing="8"
                  Background="Transparent" Tapped="Header_Tapped">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="TagText" FontSize="16" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="TypeText" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Border Grid.Column="1" Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        CornerRadius="999" Padding="8,2,8,2" VerticalAlignment="Center">
                    <TextBlock x:Name="CountText" FontSize="11" FontWeight="SemiBold"
                               FontFamily="Consolas"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
                <Button x:Name="TestButton" Grid.Column="2"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Padding="8" VerticalAlignment="Center" Click="TestButton_Click">
                    <Grid>
                        <FontIcon x:Name="TestGlyph" Glyph="&#xE945;" FontSize="16" />
                        <ProgressRing x:Name="TestRing" Width="16" Height="16"
                                      IsIndeterminate="True" IsActive="False"
                                      Visibility="Collapsed" />
                    </Grid>
                </Button>
                <Button x:Name="ChevronButton" Grid.Column="3"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Padding="8" VerticalAlignment="Center" Click="ChevronButton_Click">
                    <FontIcon x:Name="ChevronGlyph" Glyph="&#xE70D;" FontSize="14" />
                </Button>
            </Grid>
            <Grid x:Name="BodyHost" />
        </StackPanel>
    </Border>
</UserControl>
