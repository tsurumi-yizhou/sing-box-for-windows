<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SFW.Controls.DetailSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SFW.Models">

    <!-- A titled card of label/value rows: section caption, card border and the
         row layout all live here; callers only hand over the data. -->
    <StackPanel Spacing="8">
        <TextBlock x:Name="SectionTitle" FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <Border Style="{StaticResource CardBorderStyle}" Padding="16,12,16,12">
            <ItemsControl x:Name="Rows">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:DetailRow">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Label}" FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Value}" FontSize="13"
                                       FontFamily="Consolas"
                                       HorizontalAlignment="Right"
                                       TextAlignment="Right"
                                       TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </StackPanel>
</UserControl>
