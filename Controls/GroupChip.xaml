<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SFW.Controls.GroupChip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- One outbound inside a selector group (SFM group grid chip): name, type and
         either the last URL-test delay or the pending marker. The chip keeps its own
         context menu, so a right-click on any outbound offers its URL test. -->
    <Border x:Name="ChipBorder"
            CornerRadius="8"
            Padding="12,10,12,10"
            BorderThickness="1"
            Tapped="Chip_Tapped">
        <Border.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem x:Uid="GroupsTestItem" Text="Test" Click="TestItem_Click">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE945;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Border.ContextFlyout>
        <StackPanel Spacing="2">
            <TextBlock x:Name="TagText" FontSize="14" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TypeText" FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="PendingText" Grid.Column="1" Text="&#x2026;" FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" Visibility="Collapsed" />
                <TextBlock x:Name="DelayText" Grid.Column="1" FontSize="11" FontWeight="SemiBold"
                           FontFamily="Consolas" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
