<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SFW.Controls.TextPreview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Read-only preview of one report file. A TextBox is used on purpose: it is
         the only control that keeps text selectable and scrolls inside a dialog. -->
    <StackPanel Spacing="8">
        <TextBox x:Name="PreviewBox"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 FontFamily="Consolas"
                 FontSize="12"
                 Height="420"
                 HorizontalAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
        <TextBlock x:Name="TruncationNote" x:Uid="ReportFilePreviewTruncationNote"
                   Text="Showing only the last 2 MB of this file."
                   Style="{StaticResource CardCaptionTextStyle}"
                   TextWrapping="Wrap" Visibility="Collapsed" />
    </StackPanel>
</UserControl>
