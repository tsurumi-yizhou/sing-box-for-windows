<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SFW.Controls.CardLines"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SFW.Models">

    <!-- Plain label/value rows inside a card: the same line layout the Tailscale
         endpoint card uses, so the peer details dialog and the card cannot drift. -->
    <ItemsControl x:Name="Rows">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Spacing="8" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:DetailRow">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Label}"
                               Style="{StaticResource CardLineLabelTextStyle}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Value}" FontSize="14"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
