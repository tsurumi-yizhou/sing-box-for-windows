<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SFW.Controls.TailscalePeerRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <!-- One Tailscale peer as a native SettingsCard: online dot + name/badges,
         address and inline ping result underneath, actions on the right. The ping
         controls are always in the tree and only shown when the peer is reachable,
         so a snapshot refresh cannot leave a half-built row. -->
    <toolkit:SettingsCard x:Name="Card" Padding="16,8,16,8">
        <toolkit:SettingsCard.Header>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Ellipse x:Name="OnlineDot" Width="8" Height="8" VerticalAlignment="Center" />
                <TextBlock x:Name="PeerName" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <ItemsControl x:Name="Badges" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Brush}" CornerRadius="9" Padding="6,1,6,1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Text}" FontSize="10" Foreground="White" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </toolkit:SettingsCard.Header>

        <toolkit:SettingsCard.Description>
            <StackPanel Spacing="2">
                <TextBlock x:Name="PeerIpText" Style="{StaticResource CardCaptionTextStyle}" Visibility="Collapsed" />
                <StackPanel x:Name="ResultLine" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                    <TextBlock x:Name="LatencyText" FontSize="13" FontWeight="SemiBold" Visibility="Collapsed" />
                    <TextBlock x:Name="ConnectionText" Style="{StaticResource CardCaptionTextStyle}" VerticalAlignment="Center" Visibility="Collapsed" />
                </StackPanel>
                <TextBlock x:Name="ErrorText" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
        </toolkit:SettingsCard.Description>

        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button x:Name="DetailsButton" Style="{StaticResource IconActionButtonStyle}" Click="DetailsButton_Click">
                <FontIcon Glyph="&#xE946;" FontSize="14" />
            </Button>
            <Button x:Name="PingButton" Style="{StaticResource IconActionButtonStyle}" Visibility="Collapsed" Click="PingButton_Click">
                <FontIcon x:Name="PingIcon" Glyph="&#xE768;" FontSize="14" />
            </Button>
        </StackPanel>
    </toolkit:SettingsCard>
</UserControl>
