<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="sing_box_for_windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:tb="using:H.NotifyIcon" Title="Sing-Box">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The IconSource pipeline of H.NotifyIcon.WinUI re-encodes the image and
             throws on this ICO ("Argument 'picture' must be a picture that can be
             used as a Icon"), and that async exception used to kill the whole
             process before the window or tray icon appeared. The icon is loaded
             directly in code-behind (TrayIcon.Icon) instead. -->
        <tb:TaskbarIcon x:Name="TrayIcon" ToolTipText="sing-box" NoLeftClickDelay="True" Width="0" Height="0" Grid.RowSpan="2">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Name="TrayShowItem" x:Uid="TrayShow" Text="Show window">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8A7;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="TrayToggleItem" Text="Start" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="TrayQuitItem" x:Uid="TrayQuit" Text="Quit">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE7E8;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>
        <TitleBar x:Name="AppTitleBar" BackRequested="TitleBar_BackRequested" IsBackButtonVisible="{x:Bind NavFrame.CanGoBack, Mode=OneWay}" IsPaneToggleButtonVisible="True" PaneToggleRequested="TitleBar_PaneToggleRequested" />

        <!-- App name centered relative to the full title bar width -->
        <TextBlock Grid.Row="0" Text="Sing-Box" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" />

        <!-- SFM toolbar parity: start/stop control replaces the icon/title slot on the left -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="100,0,0,0">
            <Button x:Name="StartStopButton" Height="32" MinWidth="96" Click="StartStopButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="StartStopIcon" Glyph="&#xE768;" FontSize="14" />
                    <TextBlock x:Name="StartStopText" x:Uid="StartButtonText" Text="Start" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock x:Name="DurationText" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
        </StackPanel>

        <NavigationView x:Name="NavView" Grid.Row="1" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False" PaneDisplayMode="Left" OpenPaneLength="228" CompactPaneLength="48" IsSettingsVisible="False" SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="NavDashboard" Content="Dashboard" Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavGroups" x:Name="GroupsItem" Content="Groups" Tag="groups" Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavConnections" x:Name="ConnectionsItem" Content="Connections" Tag="connections" Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE701;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavLogs" Content="Logs" Tag="logs">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavTools" Content="Tools" Tag="tools">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Uid="NavSettings" Content="Settings" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Frame x:Name="NavFrame" />
        </NavigationView>
    </Grid>
</Window>
