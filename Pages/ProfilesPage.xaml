<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="SFW.Pages.ProfilesPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="40,28,40,40" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock x:Uid="ProfilesTitle" Style="{StaticResource PageTitleTextStyle}" Text="Profiles" />
            <TextBlock x:Uid="ProfilesSubtitle" Style="{StaticResource PageSubtitleTextStyle}" Text="Standard sing-box JSON configurations and HTTP(S) remote subscriptions." />
        </StackPanel>

        <!-- Windows-native left-aligned toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Click="ImportClipboardButton_Click" ToolTipService.ToolTip="Import from clipboard">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE77B;" FontSize="14" />
                    <TextBlock x:Uid="ImportClipboardText" Text="Paste" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="UpdateAllButton" Click="UpdateAllButton_Click" ToolTipService.ToolTip="Update all subscriptions">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock x:Uid="UpdateAllText" Text="Update all" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE710;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock x:Uid="AddProfileCardHeader" Style="{StaticResource CardHeaderTextStyle}" Text="Add profile" />
                </StackPanel>
                <!-- SFA NewProfileScreen parity: the selected type drives which fields are shown. -->
                <StackPanel Orientation="Horizontal" Spacing="20">
                    <TextBlock x:Uid="AddProfileTypeLabel" Style="{StaticResource CardLabelTextStyle}" Text="Profile type" VerticalAlignment="Center" />
                    <RadioButton x:Uid="AddProfileTypeLocal" x:Name="TypeLocalRadio" Content="Local" GroupName="NewProfileType" IsChecked="True" Checked="NewProfileType_Checked" />
                    <RadioButton x:Uid="AddProfileTypeRemote" x:Name="TypeRemoteRadio" Content="Remote" GroupName="NewProfileType" Checked="NewProfileType_Checked" />
                </StackPanel>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Uid="NameBox" x:Name="NameBox" Header="Profile name" PlaceholderText="My server" />
                    <TextBox x:Name="ConfigBox" Grid.Column="1" Header="Configuration file" PlaceholderText="C:\Configs\config.json" />
                    <Button x:Name="BrowseButton" Grid.Column="2" VerticalAlignment="Bottom" Style="{StaticResource ToolbarButtonStyle}" Click="BrowseButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B7;" />
                            <TextBlock x:Uid="BrowseText" Text="Browse" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}" Click="AddButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" />
                            <TextBlock x:Uid="AddProfileText" Text="Add profile" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
                <!-- Remote (subscription) options: SFA/SFM "Auto Update" + interval in minutes.
                     Labels are applied in code: x:Uid cannot resolve ToggleSwitch.Content. -->
                <StackPanel x:Name="RemoteOptionsPanel" Spacing="12" Visibility="Collapsed">
                    <ToggleSwitch x:Name="AutoUpdateToggle" Header="Auto update" IsOn="True" />
                    <NumberBox x:Name="AutoUpdateIntervalBox" Header="Auto update interval (minutes)" Minimum="15" Maximum="10080" Value="60" SmallChange="15" LargeChange="60" SpinButtonPlacementMode="Inline" />
                </StackPanel>
            </StackPanel>
        </Border>

        <InfoBar x:Name="StatusBar" Grid.Row="3" IsOpen="False" IsClosable="True" Severity="Informational" Title="Profiles" />

        <Grid Grid.Row="4" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8A5;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock x:Uid="ProfilesLabel" Style="{StaticResource CardHeaderTextStyle}" Text="Profiles" />
                </StackPanel>
                <TextBlock x:Name="CountText" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource CardLabelTextStyle}" />
            </Grid>
            <ListView x:Name="ProfilesList" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True" ItemClick="ProfilesList_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorderStyle}" Padding="14,10,14,10" RightTapped="Profile_RightTapped">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="3" CornerRadius="1.5" Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Stretch" Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <FontIcon Glyph="&#xE73E;" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding DisplaySource}" Style="{StaticResource CardCaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="4" Padding="8,2,8,2">
                                            <TextBlock Text="{Binding Type}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                        <TextBlock Text="{Binding LastUpdated}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding LastUpdateError}" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextTrimming="CharacterEllipsis" Visibility="{Binding HasLastUpdateError, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Tag="{Binding Id}" Style="{StaticResource ToolbarButtonStyle}" Click="EditButton_Click" ToolTipService.ToolTip="Edit profile">
                                        <FontIcon Glyph="&#xE70F;" />
                                    </Button>
                                    <ToggleSwitch Tag="{Binding Id}" IsOn="{Binding AutoUpdate}" Toggled="AutoUpdateToggle_Toggled" MinWidth="0" OnContent="" OffContent="" ToolTipService.ToolTip="Auto update this remote profile" IsEnabled="{Binding IsRemote}" />
                                    <Button Tag="{Binding Id}" IsEnabled="{Binding IsRemote}" Style="{StaticResource ToolbarButtonStyle}" Click="UpdateButton_Click" ToolTipService.ToolTip="Update subscription">
                                        <FontIcon Glyph="&#xE72C;" />
                                    </Button>
                                    <Button Tag="{Binding Id}" Style="{StaticResource ToolbarButtonStyle}" Click="RemoveButton_Click" ToolTipService.ToolTip="Remove profile">
                                        <FontIcon Glyph="&#xE74D;" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </Grid>
    </Grid>
</Page>
