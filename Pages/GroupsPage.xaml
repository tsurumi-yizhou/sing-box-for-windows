<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="SFW.Pages.GroupsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="40,28,40,40" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock x:Uid="GroupsTitle" Style="{StaticResource PageTitleTextStyle}" Text="Groups" />
            <TextBlock x:Uid="GroupsSubtitle" Style="{StaticResource PageSubtitleTextStyle}" Text="Selector groups supplied by the core service." />
        </StackPanel>

        <!-- Windows-native left-aligned toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="ExpandAllButton" Click="ExpandAllButton_Click" ToolTipService.ToolTip="Expand or collapse all groups">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="ExpandAllIcon" Glyph="&#xE70D;" FontSize="14" />
                    <TextBlock x:Uid="ExpandAllText" x:Name="ExpandAllText" Text="Expand all" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Click="RefreshButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock x:Uid="RefreshText" Text="Refresh" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <InfoBar x:Name="StatusBar" Grid.Row="2" IsClosable="False" IsOpen="True" Severity="Informational" Title="Groups" Message="Start a profile to receive groups from the core service." />

        <ScrollViewer Grid.Row="3">
            <StackPanel x:Name="GroupsHost" Spacing="14" />
        </ScrollViewer>
    </Grid>
</Page>
