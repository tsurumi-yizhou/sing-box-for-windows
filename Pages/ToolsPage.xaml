<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="SFW.Pages.ToolsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer>
        <StackPanel Padding="40,28,40,40" Spacing="8">

            <StackPanel Spacing="6" Margin="0,0,0,8">
                <TextBlock x:Uid="ToolsTitle" Style="{StaticResource PageTitleTextStyle}" Text="Tools" />
                <TextBlock x:Uid="ToolsSubtitle" Style="{StaticResource PageSubtitleTextStyle}" Text="Diagnostics backed by the libbox command server." />
            </StackPanel>

            <InfoBar x:Uid="ToolsStatusBar" x:Name="StatusBar" IsClosable="False" IsOpen="False" Severity="Informational" Title="Tools" />

            <!-- Endpoints: only while the core runs and the status stream reports
                 a tailscale endpoint. Cards are rebuilt from each snapshot (SFA
                 ToolsScreen), so the items are created in code. -->
            <toolkit:SettingsExpander x:Uid="EndpointsExpander" x:Name="EndpointsExpander" IsExpanded="True" Visibility="Collapsed">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE968;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </toolkit:SettingsExpander.HeaderIcon>
            </toolkit:SettingsExpander>

            <!-- Network -->
            <toolkit:SettingsExpander x:Uid="NetworkExpander" x:Name="NetworkExpander" IsExpanded="True">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE774;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </toolkit:SettingsExpander.HeaderIcon>
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard Padding="16,8,16,8" x:Uid="NetworkQualityCard" x:Name="NetworkQualityCard" IsClickEnabled="True" Click="NetworkQualityCard_Click">
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Padding="16,8,16,8" x:Uid="StunTestCard" x:Name="StunTestCard" IsClickEnabled="True" Click="StunTestCard_Click">
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>

            <!-- Debug (crash / OOM / power reports). The unread counts use the
                 native InfoBadge; the caption explains when the daemon's report
                 stores cannot be read. -->
            <toolkit:SettingsExpander x:Uid="DebugExpander" x:Name="DebugExpander" IsExpanded="True">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE9D9;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </toolkit:SettingsExpander.HeaderIcon>
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard Padding="16,8,16,8" x:Uid="CrashReportCard" x:Name="CrashReportCard" IsClickEnabled="True" Click="CrashReportCard_Click">
                        <InfoBadge x:Name="CrashReportBadge" VerticalAlignment="Center" Visibility="Collapsed" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Padding="16,8,16,8" x:Uid="OomReportCard" x:Name="OomReportCard" IsClickEnabled="True" Click="OomReportCard_Click">
                        <InfoBadge x:Name="OomReportBadge" VerticalAlignment="Center" Visibility="Collapsed" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Padding="16,8,16,8" x:Uid="PowerReportCard" x:Name="PowerReportCard" IsClickEnabled="True" Click="PowerReportCard_Click">
                        <InfoBadge x:Name="PowerReportBadge" VerticalAlignment="Center" Visibility="Collapsed" />
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
                <toolkit:SettingsExpander.ItemsFooter>
                    <TextBlock x:Uid="DebugCaption" x:Name="DebugCaption" Style="{StaticResource CardCaptionTextStyle}" Margin="16,0,16,12" TextWrapping="Wrap" Visibility="Collapsed" />
                </toolkit:SettingsExpander.ItemsFooter>
            </toolkit:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</Page>
