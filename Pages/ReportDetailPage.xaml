<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="SFW.Pages.ReportDetailPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:SFW.Models">
    <Grid Padding="40,28,40,40" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleTextStyle}" Text="Report" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitleTextStyle}" Text="Saved by the service." />
        </StackPanel>

        <InfoBar x:Name="StatusBar" Grid.Row="1" IsOpen="False" IsClosable="True" Severity="Informational" Title="Report" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Button x:Name="ExportButton" Style="{StaticResource ToolbarButtonStyle}" Click="ExportButton_Click" IsEnabled="False">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72D;" FontSize="14" />
                    <TextBlock x:Uid="ReportExportText" Text="Export" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="DeleteButton" Style="{StaticResource ToolbarButtonStyle}" Click="DeleteButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <TextBlock x:Uid="ReportDeleteText" Text="Delete" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <TextBlock x:Uid="ReportDetailFilesHeader" Grid.Row="3" Style="{StaticResource CardLabelTextStyle}" Text="Files" Margin="4,0,0,0" />

        <Grid Grid.Row="4">
            <ProgressRing x:Name="LoadingRing" Width="32" Height="32" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock x:Name="EmptyText" x:Uid="ReportEmptyText" Style="{StaticResource PageSubtitleTextStyle}" Text="Empty" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            <ScrollViewer x:Name="FileScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <Border Style="{StaticResource CardBorderStyle}">
                    <ItemsControl x:Name="FileRows">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ReportFileRow">
                                <Button Style="{StaticResource ToolbarButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="8,6,8,6"
                                        Tag="{x:Bind}"
                                        Click="FileRow_Click"
                                        AutomationProperties.Name="{x:Bind Name}">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind ProfileHint}"
                                                       Style="{StaticResource CardCaptionTextStyle}"
                                                       TextWrapping="Wrap"
                                                       Visibility="{x:Bind ProfileHintVisibility}" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="12"
                                                  VerticalAlignment="Center"
                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                  Visibility="{x:Bind ChevronVisibility}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
