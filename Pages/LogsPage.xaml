<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="SFW.Pages.LogsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="40,28,40,40" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock x:Uid="LogsTitle" Style="{StaticResource PageTitleTextStyle}" Text="Logs" />
            <TextBlock x:Uid="LogsSubtitle" Style="{StaticResource PageSubtitleTextStyle}" Text="Logs delivered by the core service." />
        </StackPanel>

        <!-- Windows-native left-aligned toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="PauseButton" Click="PauseButton_Click" ToolTipService.ToolTip="Pause">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="PauseIcon" Glyph="&#xE769;" FontSize="14" />
                    <TextBlock x:Name="PauseText" x:Uid="PauseText" Text="Pause" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <DropDownButton x:Name="LevelButton">
                <DropDownButton.Content>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE71C;" FontSize="14" />
                        <TextBlock x:Name="LevelText" x:Uid="LogLevelDefault" Text="Default" />
                    </StackPanel>
                </DropDownButton.Content>
                <DropDownButton.Flyout>
                    <MenuFlyout x:Name="LevelMenu" Opening="LevelMenu_Opening">
                        <MenuFlyoutItem x:Uid="LogLevelDefaultItem" Text="Default" Tag="7" Click="LevelItem_Click" />
                        <MenuFlyoutItem Text="Error" Tag="2" Click="LevelItem_Click" />
                        <MenuFlyoutItem Text="Warn" Tag="3" Click="LevelItem_Click" />
                        <MenuFlyoutItem Text="Info" Tag="4" Click="LevelItem_Click" />
                        <MenuFlyoutItem Text="Debug" Tag="5" Click="LevelItem_Click" />
                        <MenuFlyoutItem Text="Trace" Tag="6" Click="LevelItem_Click" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            <Button ToolTipService.ToolTip="More">
                <FontIcon Glyph="&#xE712;" />
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Uid="SaveToClipboardItem" Text="Copy to clipboard" Click="SaveToClipboard_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8C8;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="SaveToFileItem" Text="Save to file" Click="SaveToFile_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74E;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="ClearLogsItem" Text="Clear logs" Click="ClearButton_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74D;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </StackPanel>

        <TextBox x:Uid="FilterBox" x:Name="FilterBox" Grid.Row="2" PlaceholderText="Search logs" TextChanged="FilterBox_TextChanged" />

        <InfoBar x:Name="LevelFilterBar" Grid.Row="3" IsOpen="False" IsClosable="False" Severity="Informational" Title="Filter">
            <InfoBar.ActionButton>
                <Button x:Uid="ClearFilterButton" Content="Clear" Click="ClearFilter_Click" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Border Grid.Row="4" Padding="8" Style="{StaticResource CardBorderStyle}">
            <ListView x:Name="LogList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="6,2,6,2" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </Border>
    </Grid>
</Page>
