<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="SFW.Pages.PowerReportsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:SFW.Controls">
    <Grid Padding="40,28,40,40" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <TextBlock x:Uid="PowerReportsTitle" Style="{StaticResource PageTitleTextStyle}" Text="Power Report" />
                <TextBlock x:Uid="PowerReportsSubtitle" Style="{StaticResource PageSubtitleTextStyle}" Text="Reports saved for each service run while the power report is enabled." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                <Button x:Name="RefreshButton" Style="{StaticResource ToolbarButtonStyle}" Click="RefreshButton_Click" ToolTipService.ToolTip="Refresh">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
                <Button x:Name="DeleteAllButton" Style="{StaticResource ToolbarButtonStyle}" Click="DeleteAllButton_Click" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                        <TextBlock x:Uid="ReportDeleteAllText" Text="Delete all" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar x:Name="StatusBar" Grid.Row="1" IsOpen="False" IsClosable="True" Severity="Informational" Title="Power Report" />

        <!-- SFM PowerReportListView settings: one switch, one caption. -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
            <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE713;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock x:Uid="ReportSettingsHeader" Style="{StaticResource CardHeaderTextStyle}" Text="Settings" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <ToggleSwitch x:Name="PowerReportToggle" x:Uid="PowerReportToggle" Header="Enable Power Report" Toggled="PowerReportToggle_Toggled" />
                    <TextBlock x:Uid="PowerReportToggleDescription" Style="{StaticResource CardCaptionTextStyle}" TextWrapping="Wrap" Text="A report is saved for each service run" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock x:Uid="ReportSectionReports" Grid.Row="3" Style="{StaticResource CardLabelTextStyle}" Text="Reports" Margin="4,0,0,0" />

        <Grid Grid.Row="4">
            <ProgressRing x:Name="LoadingRing" Width="32" Height="32" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock x:Name="EmptyText" x:Uid="ReportEmptyText" Style="{StaticResource PageSubtitleTextStyle}" Text="Empty" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            <ScrollViewer x:Name="ReportScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <Border Style="{StaticResource CardBorderStyle}">
                    <controls:ReportList x:Name="ReportList" />
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
