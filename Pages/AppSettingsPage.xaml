<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="SFW.Pages.AppSettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer>
        <StackPanel Padding="40,28,40,40" Spacing="8">

            <StackPanel Spacing="6" Margin="0,0,0,16">
                <TextBlock x:Uid="AppSettingsTitle" Style="{StaticResource PageTitleTextStyle}" Text="App" />
                <TextBlock x:Uid="AppSettingsSubtitle" Style="{StaticResource PageSubtitleTextStyle}" TextWrapping="Wrap" Text="Theme, backdrop, startup and profiles." />
            </StackPanel>

            <!-- App appearance and startup -->
            <StackPanel Spacing="4">
                <toolkit:SettingsCard x:Uid="ThemeCard" Header="Theme" Description="Use the system setting or force a light or dark theme.">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE790;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="ThemeBox" MinWidth="140" SelectionChanged="ThemeBox_SelectionChanged">
                        <ComboBoxItem x:Uid="ThemeDefault" Content="Default" Tag="default" />
                        <ComboBoxItem x:Uid="ThemeLight" Content="Light" Tag="light" />
                        <ComboBoxItem x:Uid="ThemeDark" Content="Dark" Tag="dark" />
                    </ComboBox>
                </toolkit:SettingsCard>
                <toolkit:SettingsCard x:Uid="BackdropCard" Header="Backdrop material" Description="Choose Mica or Acrylic for the window background.">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7F8;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="BackdropBox" MinWidth="140" SelectionChanged="BackdropBox_SelectionChanged">
                        <ComboBoxItem x:Uid="BackdropMica" Content="Mica" Tag="mica" />
                        <ComboBoxItem x:Uid="BackdropAcrylic" Content="Acrylic" Tag="acrylic" />
                    </ComboBox>
                </toolkit:SettingsCard>
                <toolkit:SettingsCard x:Uid="LanguageCard" x:Name="LanguageCard" Header="Language" Description="Use the system language or force one for the app. Restart to apply.">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8C1;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="LanguageBox" MinWidth="180" SelectionChanged="LanguageBox_SelectionChanged">
                        <ComboBoxItem x:Uid="LanguageSystem" Content="System default" Tag="" />
                        <ComboBoxItem Content="English" Tag="en-US" />
                        <ComboBoxItem Content="简体中文" Tag="zh-CN" />
                        <ComboBoxItem Content="繁體中文" Tag="zh-HK" />
                    </ComboBox>
                </toolkit:SettingsCard>
                <TextBlock x:Uid="LanguageRestartHint" x:Name="LanguageRestartHint" Style="{StaticResource CardCaptionTextStyle}" Margin="4,0,0,6" TextWrapping="Wrap" Visibility="Collapsed" />
                <toolkit:SettingsCard x:Uid="LaunchCard" x:Name="LaunchCard" Header="Start at login" Description="Run in the tray and start the service when you sign in.">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8EC;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="LaunchAtLoginToggle" Toggled="LaunchAtLoginToggle_Toggled" />
                </toolkit:SettingsCard>
            </StackPanel>

            <!-- Profiles -->
            <TextBlock x:Uid="SettingsProfilesTitle" Style="{StaticResource CardLabelTextStyle}" Text="PROFILES" Margin="4,16,0,4" />
            <toolkit:SettingsCard x:Uid="ProfilesCard" Header="Manage profiles" Description="Profiles are standard sing-box JSON configurations stored in the app data directory." IsClickEnabled="True" Click="OpenProfilesButton_Click">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8A5;" />
                </toolkit:SettingsCard.HeaderIcon>
            </toolkit:SettingsCard>

            <!-- App version -->
            <toolkit:SettingsCard x:Name="VersionCard" Header="Sing-Box for Windows" Margin="0,16,0,0">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE946;" />
                </toolkit:SettingsCard.HeaderIcon>
            </toolkit:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
