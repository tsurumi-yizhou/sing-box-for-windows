<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="SFW.Pages.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer>
        <StackPanel Padding="40,28,40,40" Spacing="8">

            <StackPanel Spacing="6" Margin="0,0,0,8">
                <TextBlock x:Uid="SettingsTitle" Style="{StaticResource PageTitleTextStyle}" Text="Settings" />
                <TextBlock x:Uid="SettingsSubtitle" Style="{StaticResource PageSubtitleTextStyle}" TextWrapping="Wrap" Text="App, core, service and about links." />
            </StackPanel>

            <InfoBar x:Uid="SettingsStatusBar" x:Name="StatusBar" IsClosable="True" IsOpen="False" Severity="Error" />

            <!-- General: the SFA/SFM hub groups, grouped by the native
                 SettingsExpander so section headers, chevrons and the collapsed
                 states come from the Windows settings controls instead of a
                 hand-drawn list. All copy comes from x:Uid resources. -->
            <toolkit:SettingsExpander x:Uid="GeneralExpander" x:Name="GeneralExpander" IsExpanded="True">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE713;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </toolkit:SettingsExpander.HeaderIcon>
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard Padding="16,8,16,8" x:Uid="AppCard" x:Name="AppCard" IsClickEnabled="True" Click="AppCard_Click">
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Padding="16,8,16,8" x:Uid="CoreCard" x:Name="CoreCard" IsClickEnabled="True" Click="CoreCard_Click">
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Padding="16,8,16,8" x:Uid="ServiceCard" x:Name="ServiceCard" IsClickEnabled="True" Click="ServiceCard_Click">
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>

            <!-- About: documentation, source code and sponsor links. The
                 external-link glyph replaces the navigation chevron. -->
            <toolkit:SettingsExpander x:Uid="AboutExpander" x:Name="AboutExpander" IsExpanded="True">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE8A5;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </toolkit:SettingsExpander.HeaderIcon>
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard Padding="16,8,16,8" x:Uid="DocumentationCard" x:Name="DocumentationCard" IsClickEnabled="True" Click="DocumentationCard_Click">
                        <toolkit:SettingsCard.ActionIcon>
                            <FontIcon Glyph="&#xE8A7;" />
                        </toolkit:SettingsCard.ActionIcon>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Padding="16,8,16,8" x:Uid="SourceCodeCard" x:Name="SourceCodeCard" IsClickEnabled="True" Click="SourceCodeCard_Click">
                        <toolkit:SettingsCard.ActionIcon>
                            <FontIcon Glyph="&#xE8A7;" />
                        </toolkit:SettingsCard.ActionIcon>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Padding="16,8,16,8" x:Uid="SponsorCard" x:Name="SponsorCard" IsClickEnabled="True" Click="SponsorCard_Click">
                        <toolkit:SettingsCard.ActionIcon>
                            <FontIcon Glyph="&#xE8A7;" />
                        </toolkit:SettingsCard.ActionIcon>
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</Page>
