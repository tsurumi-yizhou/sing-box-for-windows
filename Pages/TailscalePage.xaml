<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="SFW.Pages.TailscalePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="40,28,40,40" Spacing="16">

            <StackPanel Spacing="6">
                <TextBlock x:Name="PageTitle" Style="{StaticResource PageTitleTextStyle}" Text="Tailscale" />
                <TextBlock x:Name="PageSubtitle" Style="{StaticResource PageSubtitleTextStyle}" TextWrapping="Wrap" />
            </StackPanel>

            <InfoBar x:Name="StatusBar" IsClosable="False" IsOpen="False" Severity="Informational" Title="Tailscale" />

            <!-- SFM/SFA Tools parity: one native SettingsExpander card per
                 endpoint, built from the command-server stream. -->
            <StackPanel x:Name="TailscaleCard" Spacing="16" Visibility="Collapsed">
                <ProgressRing x:Name="TailscaleProgress" IsActive="False" Visibility="Collapsed" Width="20" Height="20" HorizontalAlignment="Left" />
                <StackPanel x:Name="TailscaleEndpoints" Spacing="16" />
                <TextBlock x:Name="TailscaleEmptyText" Style="{StaticResource CardCaptionTextStyle}" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
