<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="SFW.Pages.ConnectionsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="40,28,40,40" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock x:Uid="ConnectionsTitle" Style="{StaticResource PageTitleTextStyle}" Text="Connections" />
            <TextBlock x:Uid="ConnectionsSubtitle" Style="{StaticResource PageSubtitleTextStyle}" Text="Live connections supplied by the core service." />
        </StackPanel>

        <!-- Windows-native left-aligned toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <DropDownButton x:Name="StateFilterButton">
                <DropDownButton.Content>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE71C;" FontSize="14" />
                        <TextBlock x:Name="StateFilterText" x:Uid="StateFilterActiveText" Text="Active" />
                    </StackPanel>
                </DropDownButton.Content>
                <DropDownButton.Flyout>
                    <MenuFlyout x:Name="StateFilterMenu" Opening="StateFilterMenu_Opening">
                        <MenuFlyoutItem x:Uid="FilterAll" Text="All" Tag="all" Click="StateFilterItem_Click" />
                        <MenuFlyoutItem x:Uid="FilterActive" Text="Active" Tag="active" Click="StateFilterItem_Click" />
                        <MenuFlyoutItem x:Uid="FilterClosed" Text="Closed" Tag="closed" Click="StateFilterItem_Click" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            <DropDownButton x:Name="SortButton">
                <DropDownButton.Content>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8CB;" FontSize="14" />
                        <TextBlock x:Name="SortText" x:Uid="SortByDateText" Text="Date" />
                    </StackPanel>
                </DropDownButton.Content>
                <DropDownButton.Flyout>
                    <MenuFlyout x:Name="SortMenu" Opening="SortMenu_Opening">
                        <MenuFlyoutItem x:Uid="SortByDate" Text="Date" Tag="date" Click="SortItem_Click" />
                        <MenuFlyoutItem x:Uid="SortByTraffic" Text="Traffic" Tag="traffic" Click="SortItem_Click" />
                        <MenuFlyoutItem x:Uid="SortByTrafficTotal" Text="Traffic Total" Tag="trafficTotal" Click="SortItem_Click" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            <Button Click="CloseAllButton_Click" ToolTipService.ToolTip="Close all connections">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                    <TextBlock x:Uid="CloseAllText" Text="Close all" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <TextBox x:Uid="ConnectionSearchBox" x:Name="SearchBox" Grid.Row="2" PlaceholderText="Search connections" TextChanged="SearchBox_TextChanged" />

        <InfoBar x:Name="StatusBar" Grid.Row="3" IsOpen="False" IsClosable="False" Severity="Informational" Title="Connections" />

        <ListView x:Name="ConnectionsList" Grid.Row="4" SelectionMode="None" ItemClick="Connection_Click" IsItemClickEnabled="True">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="14" Style="{StaticResource CardBorderStyle}" RightTapped="Connection_RightTapped">
                        <StackPanel Spacing="4">
                            <Grid>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource MonoTextStyle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="{Binding UpText}" Style="{StaticResource MonoCaptionTextStyle}" />
                                <TextBlock Text="{Binding InboundText}" Style="{StaticResource MonoCaptionTextStyle}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="{Binding DownText}" Style="{StaticResource MonoCaptionTextStyle}" />
                                <TextBlock Text="{Binding ChainText}" Style="{StaticResource MonoCaptionTextStyle}" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </Grid>
</Page>
