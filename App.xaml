<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="SFW.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:SFW" xmlns:services="using:SFW.Services">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="UrlTestGoodBrush" Color="#3D8168" />
                    <SolidColorBrush x:Key="UrlTestMediumBrush" Color="#A8742F" />
                    <SolidColorBrush x:Key="UrlTestBadBrush" Color="#C25E32" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="UrlTestGoodBrush" Color="#7CB89E" />
                    <SolidColorBrush x:Key="UrlTestMediumBrush" Color="#D3A45E" />
                    <SolidColorBrush x:Key="UrlTestBadBrush" Color="#DB8A62" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <services:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <services:EmptyStringToBoolConverter x:Key="EmptyStringToBoolConverter" />
            <services:DelayToBrushConverter x:Key="DelayToBrushConverter" />

            <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="PageSubtitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="20" />
            </Style>
            <!-- Dashboard card header: icon + bold title, aligned with SFA/SFM card headers -->
            <Style x:Key="CardHeaderTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="CardTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="CardLabelTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="120" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <!-- Key/value rows inside dashboard cards (Memory / Goroutines / Inbound / Outbound) -->
            <Style x:Key="CardLineLabelTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="CardLineValueTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>
            <Style x:Key="CardValueTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="Medium" />
            </Style>
            <Style x:Key="CardCaptionTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            </Style>
            <!-- Monospace text used by connections and logs, like SFA/SFM -->
            <Style x:Key="MonoTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="MonoCaptionTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <!-- Small icon-only action button used in card headers and list rows -->
            <Style x:Key="ToolbarButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="12,8,12,8" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <!-- Segmented selector (Clash mode): container + item, Fluent segmented look -->
            <Style x:Key="SegmentedContainerStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="4" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
