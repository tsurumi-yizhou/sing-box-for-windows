+package clashmode
+
+import (
+	"context"
+	"reflect"
+	"testing"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/log"
+)
+
+type desktopTestDNSRouter struct {
+	adapter.DNSRouter
+	cleared bool
+}
+
+func (r *desktopTestDNSRouter) ClearCache() { r.cleared = true }
+
+type desktopTestLogger struct{ log.Logger }
+
+func (desktopTestLogger) Info(args ...any) {}
+
+func TestDesktopSingleMode(t *testing.T) {
+	for _, test := range []struct {
+		name    string
+		current string
+		modes   []string
+		want    []string
+	}{
+		{"global", "Global", []string{"Global"}, []string{"Rule", "Global"}},
+		{"direct", "direct", []string{"direct"}, []string{"rule", "direct"}},
+		{"custom", "Custom", []string{"Custom"}, []string{"Rule", "Custom"}},
+		{"rule", "Rule", []string{"Rule"}, []string{"Rule"}},
+		{"lowercase rule", "rule", []string{"rule"}, []string{"rule"}},
+		{"empty", "", nil, []string{"Rule"}},
+		{"multiple", "Global", []string{"Global", "Direct"}, []string{"Global", "Direct"}},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			manager := NewManager(context.Background(), desktopTestLogger{}, test.current, test.modes)
+			if !reflect.DeepEqual(manager.ModeList(), test.want) {
+				t.Fatalf("modes = %v, want %v", manager.ModeList(), test.want)
+			}
+			if test.current != "" && manager.Mode() != test.current {
+				t.Fatalf("initial mode changed: %q", manager.Mode())
+			}
+			if len(test.modes) == 1 && len(test.want) == 2 {
+				dns := &desktopTestDNSRouter{}
+				manager.dnsRouter = dns
+				manager.SetMode(test.want[0])
+				if manager.Mode() != test.want[0] || !dns.cleared {
+					t.Fatal("Rule must be selectable and clear the DNS cache")
+				}
+				manager.SetMode(test.current)
+				if manager.Mode() != test.current {
+					t.Fatal("original mode must remain selectable")
+				}
+			}
+		})
+	}
+}
