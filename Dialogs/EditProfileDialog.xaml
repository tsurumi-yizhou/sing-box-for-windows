<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="SFW.Dialogs.EditProfileDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Uid="EditProfileDialog"
    Title="Edit profile"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <!-- SFM EditProfileView parity. A local profile is an app-owned copy, so the
         dialog edits its name and offers an explicit replacement; the import path
         is never shown or required. Remote profiles still edit their URL. -->
    <StackPanel Spacing="12">
        <TextBox x:Uid="EditProfileNameBox" x:Name="NameBox" Header="Profile name" />

        <TextBox x:Name="SourceBox" MinWidth="420" Visibility="Collapsed" />

        <StackPanel x:Name="LocalConfigPanel" Spacing="8" Visibility="Collapsed">
            <Button x:Uid="EditProfileReplaceButton" Click="ReplaceButton_Click" />
            <TextBlock x:Name="ReplacementText" Style="{StaticResource CardCaptionTextStyle}" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
        </StackPanel>

        <NumberBox x:Uid="EditProfileIntervalBox" x:Name="IntervalBox"
                   Header="Auto update interval (minutes)"
                   Minimum="15" Maximum="10080" Value="60" SmallChange="15" LargeChange="60"
                   SpinButtonPlacementMode="Inline" Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>
