<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="SFW.Dialogs.ConfirmDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    DefaultButton="Close">

    <!-- A confirmation prompt whose text varies per call: the layout is XAML,
         the strings come from resources by key (see the constructor). -->
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
</ContentDialog>
