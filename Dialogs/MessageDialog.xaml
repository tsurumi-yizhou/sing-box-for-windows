<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="SFW.Dialogs.MessageDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    DefaultButton="Close">

    <!-- A single-message prompt (error or notice). The title, the message and
         the close label come from resources; the layout lives here. -->
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
</ContentDialog>
