<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="SFW.Dialogs.AddProfileDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Uid="AddProfileDialog"
    Title="Add profile"
    PrimaryButtonText="Add"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="PrimaryButton_Click">

    <!-- SFA NewProfileScreen parity: one form whose fields follow the selected
         type. A subscription is simply a remote profile - same entry point and
         name field - and remote profiles carry the auto-update switch plus the
         interval they are scheduled with. -->
    <StackPanel Spacing="12">
        <TextBox x:Uid="AddProfileNameBox" x:Name="NameBox"
                 Header="Profile name (optional)" PlaceholderText="My server" />

        <StackPanel Spacing="6">
            <TextBlock x:Uid="AddProfileTypeLabel" Text="Profile type" />
            <StackPanel Orientation="Horizontal" Spacing="20">
                <RadioButton x:Uid="AddProfileLocalRadio" x:Name="LocalRadio" Content="Local"
                             GroupName="NewProfileType" IsChecked="True" Checked="TypeRadio_Checked" />
                <RadioButton x:Uid="AddProfileRemoteRadio" x:Name="RemoteRadio" Content="Remote"
                             GroupName="NewProfileType" Checked="TypeRadio_Checked" />
            </StackPanel>
        </StackPanel>

        <Grid x:Name="PathGrid" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Uid="AddProfilePathBox" x:Name="PathBox" MinWidth="420"
                     Header="Configuration file" PlaceholderText="C:\Configs\config.json" />
            <Button x:Uid="AddProfileBrowseButton" x:Name="BrowseButton" Grid.Column="1"
                    Content="Browse" VerticalAlignment="Bottom" Click="BrowseButton_Click" />
        </Grid>

        <StackPanel x:Name="RemotePanel" Spacing="12" Visibility="Collapsed">
            <TextBox x:Uid="AddProfileUrlBox" x:Name="UrlBox" MinWidth="420"
                     Header="Subscription URL" PlaceholderText="https://example.com/config.json" />
            <ToggleSwitch x:Uid="AddProfileAutoUpdateToggle" x:Name="AutoUpdateToggle"
                          Header="Auto update" IsOn="True" MinWidth="0" OnContent="" OffContent="" />
            <NumberBox x:Uid="AddProfileIntervalBox" x:Name="IntervalBox"
                       Header="Auto update interval (minutes)"
                       Minimum="15" Maximum="10080" Value="60" SmallChange="15" LargeChange="60"
                       SpinButtonPlacementMode="Inline" />
        </StackPanel>

        <!-- Progress and errors live inside the form: the download keeps the dialog
             open, so the entered URL survives a failure instead of being replaced
             by a toast. -->
        <StackPanel x:Name="ProgressRow" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
            <ProgressRing x:Name="ProgressRing" IsActive="False" Width="16" Height="16" />
            <TextBlock x:Uid="AddProfileDownloadingText" Text="Downloading the subscription…"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="Collapsed"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
    </StackPanel>
</ContentDialog>
