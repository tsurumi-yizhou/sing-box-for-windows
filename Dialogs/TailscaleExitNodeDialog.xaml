<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="SFW.Dialogs.TailscaleExitNodeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Uid="TailscaleExitNodeDialog"
    Title="Exit node"
    CloseButtonText="Close"
    DefaultButton="Close">

    <!-- SFM exit-node picker: one stretched row per candidate, with the check mark
         slot, the online dot and the peer's first address. Rows come from the
         latest snapshot, so the dialog holds no state of its own. -->
    <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="Options">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="8,6,8,6"
                            Tag="{Binding}"
                            AutomationProperties.Name="{Binding Title}"
                            Click="Option_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Width="16" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE73E;" FontSize="12"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                          Visibility="{Binding CheckVisibility}" />
                            </Border>
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{Binding DotBrush}"
                                     Visibility="{Binding DotVisibility}" />
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Ip}"
                                           Style="{StaticResource CardCaptionTextStyle}"
                                           Visibility="{Binding IpVisibility}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</ContentDialog>
