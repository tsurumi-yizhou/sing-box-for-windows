<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="SFW.Dialogs.DetailDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- A dialog whose body is supplied by the caller: the chrome (title, scroll
         area, buttons) lives here, only the body element is passed in. -->
    <ScrollViewer x:Name="BodyScroller" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <ContentPresenter x:Name="Body" />
    </ScrollViewer>
</ContentDialog>
