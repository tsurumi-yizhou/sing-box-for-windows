<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SFW.Tests</RootNamespace>
    <!-- The daemon authenticates this application basename and signer. -->
    <AssemblyName>sing-box</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" Version="2.83.0" />
    <PackageReference Include="Google.Protobuf" Version="3.29.3" />
    <PackageReference Include="Grpc.Tools" Version="2.83.0" PrivateAssets="All" />
    <Protobuf Include="..\Protos\started_service.proto" GrpcServices="Client" ProtoRoot="..\Protos" />
    <Protobuf Include="..\Protos\desktop_service.proto" GrpcServices="Client" ProtoRoot="..\Protos" />
    <Content Include="..\daemon\**\*" Link="resources\daemon\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="..\Services\Core\RpcSubscription.cs" Link="RpcSubscription.cs" />
    <Compile Include="..\Services\AtomicFile.cs" Link="AtomicFile.cs" />
    <Compile Include="..\Services\Core\ConfigurationValidator.cs" Link="ConfigurationValidator.cs" />
    <Compile Include="..\Services\Core\NamedPipeChannel.cs" Link="NamedPipeChannel.cs" />
  </ItemGroup>
</Project>
